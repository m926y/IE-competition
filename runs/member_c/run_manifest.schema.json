{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Member C scoring run manifest",
  "type": "object",
  "required": [
    "run_id",
    "generated_at",
    "as_of_timestamp",
    "random_seed",
    "rule_version",
    "source_experiments",
    "input_files",
    "feature_fields",
    "runtime",
    "weights",
    "calibration",
    "outputs",
    "elapsed_seconds",
    "validation_status"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "as_of_timestamp": {"type": "string"},
    "random_seed": {"type": "integer"},
    "rule_version": {"type": "string"},
    "source_experiments": {"type": "object"},
    "input_files": {"type": "object", "additionalProperties": {"type": "string"}},
    "feature_fields": {"type": "array", "items": {"type": "string"}},
    "runtime": {"type": "object"},
    "weights": {"type": "object", "additionalProperties": {"type": "number"}},
    "calibration": {"type": "object"},
    "quality": {"type": "object"},
    "metrics_summary": {"type": "object"},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "validation_status": {"enum": ["pass", "review_required"]}
  },
  "additionalProperties": true
}
